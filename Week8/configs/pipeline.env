# ============================================================================
#  pipeline.env — Week8 Day40
#  全流水线（step1 数据 / step2 训练 / step3 评测 / step4 部署）共用的变量定义。
#  Shared variable definitions for every stage of the Week8 pipeline.
#
#  用法 / Usage —— 在任何 stage 脚本开头：
#      REPO="$(cd "$(dirname "$0")/../.." && pwd)"
#      . "$REPO/Week8/configs/pipeline.env"
#
#  ★ 为什么这个文件必须是"纯 POSIX sh"而不是 bash 脚本
#    step2/step3/step4 由不同的人（不同 agent）写，可能用 `bash`、也可能用 `sh`
#    (dash) 或 `set -u` 下的严格模式来 source 它。所以这里**不能**出现：
#      · 数组 `arr=(a b)`        · `[[ ]]`          · `${VAR,,}` 大小写变换
#      · `local` / `function`    · `source`（要用 `.`）
#    只用 `VAR="${VAR:-default}"` 这一种写法——它同时保证了
#    「调用方可以用环境变量覆盖任何一项」和「-u 严格模式下不会因未定义变量报错」。
#    Pure POSIX sh: no arrays, no [[ ]], no bashisms — every downstream stage
#    must be able to `.` this file under bash or dash, with or without `set -u`.
#
#  ★ 为什么路径全部用双引号包起来
#    仓库真实路径是 C:\Users\Ruibo's Desktop\SenceTime_Weeks1-5 —— 同时含
#    **空格**和**英文撇号**。撇号在 shell 里会开启单引号串，不加双引号的话
#    任何一处展开都会把后面的整行吞掉。凡是拼路径的地方一律 "$VAR"。
#    The repo path contains both a space and an apostrophe; always quote.
# ============================================================================

# ---------------------------------------------------------------------------
# REPO —— 仓库根目录。调用方**应当**在 source 之前自己算好（见上方 Usage），
# 因为在 `sh` 里被 source 时既没有 $BASH_SOURCE 也没有可靠的 $0。
# 这里只做兜底：未设置就用当前工作目录，并用一个哨兵文件校验对不对。
# Callers should set REPO first; we fall back to $PWD and sanity-check it.
# ---------------------------------------------------------------------------
REPO="${REPO:-$(pwd)}"
# ★ Git Bash 下必须把 REPO 转成 "C:/..." 形式（cygpath -m，混合风格）。
#   原因：MSYS 的 $(pwd) 给出的是 "/c/Users/..."，而本仓库里真正干活的是
#   **原生 Windows Python**（.venv/Scripts/python.exe）——它把 "/c/Users/..." 当成
#   当前盘符下的目录，打开必失败。MSYS 虽然会对部分参数做路径转换，但
#   只对"看起来像路径的单个参数"生效，拼接过的字符串、写进 JSON 的值都不会转。
#   "C:/..." 形式是唯一两边都认的：bash 的 [ -f ] 能读，Windows Python 也能读。
#   WSL/Linux 上没有 cygpath，这段自动跳过，POSIX 路径本来就是对的。
#   cygpath -m gives "C:/..." — the only form both MSYS bash and native
#   Windows Python accept. Skipped automatically on WSL/Linux.
if command -v cygpath >/dev/null 2>&1; then
    REPO="$(cygpath -m "$REPO")"
fi
if [ ! -f "$REPO/Week8/configs/pipeline.env" ]; then
    echo "[pipeline.env][FATAL] REPO 指向的不是仓库根: $REPO" >&2
    echo "[pipeline.env]        请在 source 之前设置 REPO，例如：" >&2
    echo '                      REPO="$(cd "$(dirname "$0")/../.." && pwd)"' >&2
    return 1 2>/dev/null || exit 1
fi
export REPO

# ---------------------------------------------------------------------------
# PYTHON —— 解释器。
# ★ Windows 侧固定用 .venv/Scripts/python.exe（不是系统 python）：llamafactory
#   是用 `--no-deps` 装进这个 venv 的，系统 python 里根本没有。
# ★ 而且**只能**用 `"$PYTHON" -m llamafactory.cli`，绝不能用
#   .venv/Scripts/llamafactory-cli.exe —— Week2 Day10 实测该入口在 Windows 上
#   段错误（console_script 的 wrapper 与 torch DLL 加载顺序冲突）。
# WSL/Linux 下（Week7 的 vllm/quant/lf 环境）自动回退到 PATH 上的 python。
# ---------------------------------------------------------------------------
if [ -z "${PYTHON:-}" ]; then
    if [ -x "$REPO/.venv/Scripts/python.exe" ]; then
        PYTHON="$REPO/.venv/Scripts/python.exe"          # Windows 主环境
    elif [ -x "$REPO/.venv/bin/python" ]; then
        PYTHON="$REPO/.venv/bin/python"                  # 万一是 POSIX 版 venv
    else
        PYTHON="python"                                  # WSL: 由 activate 决定
    fi
fi
export PYTHON

# 控制台打印中文用。Windows 的 cp936 默认编码会让脚本在 print 中文时直接抛
# UnicodeEncodeError（前几周反复踩到），在这里统一设死。
export PYTHONIOENCODING="${PYTHONIOENCODING:-utf-8}"

# ---------------------------------------------------------------------------
# 模型 / Models
# ---------------------------------------------------------------------------
# 训练起点：原始基座。SFT 从这里出发。
BASE_MODEL="${BASE_MODEL:-$REPO/models/Qwen2.5-3B-Instruct}"
# 对话模板。Qwen 系列走 ChatML；训练/合并/推理三处必须完全一致，否则
# 合并出来的模型在推理时会因为特殊 token 对不上而胡言乱语。
TEMPLATE="${TEMPLATE:-qwen}"

# ---------------------------------------------------------------------------
# 训练产物目录 / Training outputs
#   OUT_*     = LoRA adapter 目录（LLaMA-Factory 的 output_dir）
#   MERGED_*  = adapter 合并回基座后的完整模型目录（export_dir）
# ★ 命名沿用 Week3/Week4 的 saves/weekN/{model}/{exp} 规范，只把 weekN 换成
#   week8，这样 tensorboard 和既有的分析脚本不用改路径规则。
# ---------------------------------------------------------------------------
OUT_SFT="${OUT_SFT:-$REPO/saves/week8/qwen/sft_best}"
OUT_DPO="${OUT_DPO:-$REPO/saves/week8/qwen/dpo_best}"
MERGED_SFT="${MERGED_SFT:-$REPO/models/Qwen2.5-3B-week8-sft-merged}"
MERGED_DPO="${MERGED_DPO:-$REPO/models/Qwen2.5-3B-week8-dpo-merged}"

# ---------------------------------------------------------------------------
# 数据 / Data —— 全部由 step1_data_prep.py 产出并注册
# DATA_DIR 同时是 LLaMA-Factory 的 dataset_dir（dataset_info.json 就在里面）。
# ---------------------------------------------------------------------------
DATA_DIR="${DATA_DIR:-$REPO/Week8/data}"
SFT_TRAIN_DATASET="${SFT_TRAIN_DATASET:-week8_sft_train}"    # Alpaca 格式训练集
SFT_VAL_DATASET="${SFT_VAL_DATASET:-week8_sft_val}"          # Alpaca 格式验证集
DPO_TRAIN_DATASET="${DPO_TRAIN_DATASET:-week8_dpo_train}"    # 偏好对训练集
DPO_VAL_DATASET="${DPO_VAL_DATASET:-week8_dpo_val}"          # 偏好对验证集

# ---------------------------------------------------------------------------
# 配置文件 / Config files
# ---------------------------------------------------------------------------
CFG_DIR="${CFG_DIR:-$REPO/Week8/configs}"
SFT_CONFIG="${SFT_CONFIG:-$CFG_DIR/sft_best.yaml}"
DPO_CONFIG="${DPO_CONFIG:-$CFG_DIR/dpo_best.yaml}"
MERGE_SFT_CONFIG="${MERGE_SFT_CONFIG:-$CFG_DIR/merge_sft.yaml}"
MERGE_DPO_CONFIG="${MERGE_DPO_CONFIG:-$CFG_DIR/merge_dpo.yaml}"

# ---------------------------------------------------------------------------
# 日志与交付 / Logs & deliverables
# LOG_DIR 下的文件名统一为 <stage>_<timestamp>.log，便于 step3 事后捞日志。
# ---------------------------------------------------------------------------
LOG_DIR="${LOG_DIR:-$REPO/Week8/logs}"
DELIV_DIR="${DELIV_DIR:-$REPO/Week8/deliverables}"
RETRY_HISTORY="${RETRY_HISTORY:-$LOG_DIR/retry_history.json}"

# ---------------------------------------------------------------------------
# 重试策略 / Retry policy（40.3）
# MAX_RETRIES：OOM 后最多再降配重试几次。3 档降配（见 step2_train.sh 的
# RETRY_LADDER 注释）之后仍 OOM，基本就不是 batch 能救的问题了，直接失败退出
# 比无限重试更有价值——它逼你去看真正的原因（比如别的进程占着卡）。
# ---------------------------------------------------------------------------
MAX_RETRIES="${MAX_RETRIES:-3}"
# --quick 冒烟时每个 stage 只跑这么多步，用来验证"调用链通不通"，不产出可用模型。
QUICK_STEPS="${QUICK_STEPS:-2}"

# ---------------------------------------------------------------------------
# 磁盘水位 / Disk guard
# 合并一个 3B bf16 模型要写约 6GB。C 盘长期在 90%+，合并前先查余量，
# 不够就早失败——总比写到一半 ENOSPC、留下一个半截模型目录强。
# ---------------------------------------------------------------------------
MIN_FREE_GB="${MIN_FREE_GB:-10}"

# 供调用方判断"我 source 到了吗"
PIPELINE_ENV_LOADED=1
export PIPELINE_ENV_LOADED
